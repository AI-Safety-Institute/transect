<!DOCTYPE html>
<html><head><meta charset="utf-8">
<title>{{ title }}</title>
<link rel="icon" type="image/png" href="{{ favicon_uri }}">
{#- the chart runtime first, so the page's own rules below win ties -#}
{{ chart_head }}
<style>{{ style }}</style>
</head><body{% if sensitivity %} class="classified"{% endif %}>
{%- if sensitivity %}
{#- Protective marking at top and bottom of the viewport - the
    digital analogue of the marking on every page; position:fixed
    also repeats on each printed page. -#}
<div class="sensitivity-banner sensitivity-top">{{ sensitivity }}</div>
<div class="sensitivity-banner sensitivity-bottom">{{ sensitivity }}</div>
{%- endif %}
<h1><img class="brand-logo" src="{{ logo_uri }}" alt=""> {{ title }}</h1>
{% if index_href %}<p><a href="{{ index_href }}">&larr; Run index</a></p>{% endif %}
<p class="meta">scan: {{ scan_location }} · {{ n_transcripts }} transcript(s)</p>
{%- if scan_status_view.failures %}
<p class="warning flag">&#9888; Some requested scanners failed or have missing coverage - see <a href="#scan-status">Scan execution &amp; coverage</a>.</p>
{%- endif %}
{#- Fit-to-window is the default view; this checkbox opts into the
    zoomed-in, horizontally-scrollable variant - full per-turn pixel
    resolution for laptop-screen reading. -#}
<p class="meta"><label title="Renders each chart at its full authored width (higher per-turn resolution) inside a horizontal scroll box, instead of scaling it down to fit the window."><input type="checkbox" id="transect-zoom-toggle"> zoomed-in charts (scroll horizontally)</label></p>
{% if not transcripts %}<p>No transcripts in results.</p>{% endif %}
{% for t in transcripts %}
<div class="transcript" id="{{ t.anchor }}">
<h2>{{ t.heading }}</h2>
{% if t.run_meta %}{{ t.run_meta }}{% endif %}
{% for section in t.sections %}{{ section }}{% endfor %}
</div>
{% endfor %}
{% include "scan_status.html.j2" %}
{#- Provenance footer: the mark, the producing package + version,
    and the repo - the report itself carries its attribution. -#}
<footer class="report-footer"><img src="{{ logo_uri }}" alt=""><span>Produced with Transect v{{ package_version }} · <a href="https://github.com/AI-Safety-Institute/transect">github.com/AI-Safety-Institute/transect</a></span></footer>
{#- Fixed bottom-right "Back to top": the way back after a band click
    jumps the reader to a phase card. Hidden until they have scrolled a
    screen. -#}
<button id="transect-back-top" onclick="window.scrollTo({top: 0, behavior: 'smooth'})" title="Back to the top of the page">&uarr; Back to top</button>
<script>
// Band chunks link to their phase card (href, ids transcript-scoped
// "#phase-<idx>-<n>"). Fragment navigation scrolls;
// this additionally opens the target <details> (native auto-open is
// not yet universal). The "#phase-" prefix check matches either id
// shape without parsing it.
function _transectOpenPhaseFromHash() {
  var hash = location.hash;
  if (!hash || hash.indexOf("#phase-") !== 0) return;
  var target = document.getElementById(hash.slice(1));
  if (!target) return;
  // A card filter may have hidden the target (a hidden anchor is a
  // link to nowhere): clear that card scope's filters first.
  if (target.style.display === "none") {
    var scope = target.closest(".phase-cards");
    if (scope) _transectClearCardFilters(scope.id);
  }
  if (target.tagName === "DETAILS") target.open = true;
  target.scrollIntoView({behavior: "smooth", block: "start"});
}
window.addEventListener("hashchange", _transectOpenPhaseFromHash);
document.addEventListener("DOMContentLoaded", _transectOpenPhaseFromHash);

// Sort/filter handlers for the phase cards (".filter-bar[data-scope]"
// + "div.phase-cards#<scope>"). Every lookup is scoped to one
// containerId so multiple transcripts on one page cannot cross-filter.
function _transectCardSort(containerId, by) {
  var c = document.getElementById(containerId);
  if (!c) return;
  var cards = Array.prototype.slice.call(c.querySelectorAll(".event"));
  // Always re-sort from data-order (this card's render-time,
  // chronological/phase_index position) first, regardless of the DOM's
  // current order - so repeated calls are idempotent (a "chronological"
  // pick after a "spend" pick genuinely restores phase order, not just
  // whatever the DOM happens to be in already) and so a "spend" sort's
  // own ties break chronologically (Array.sort is spec-guaranteed stable
  // in every evergreen browser, so this second sort's ties keep the
  // order the first sort just established).
  cards.sort(function(a, b) {
    return (parseFloat(a.getAttribute("data-order")) || 0)
         - (parseFloat(b.getAttribute("data-order")) || 0);
  });
  if (by === "spend" || by === "tools") {
    var attr = by === "spend" ? "data-spend" : "data-tools";
    cards.sort(function(a, b) {
      return (parseFloat(b.getAttribute(attr)) || 0)
           - (parseFloat(a.getAttribute(attr)) || 0);
    });
  }
  cards.forEach(function(el) { c.appendChild(el); });
}

// Label filter = per-label checkboxes (all checked = all shown);
// confidence bands: high >= 0.8, low < 0.6 (the scanner's own
// low-confidence trigger). A card with no recorded confidence fails
// BOTH bands when one is active - absence is not evidence of either.
function _transectLabelChecks(containerId) {
  var bar = document.querySelector('.filter-bar[data-scope="' + containerId + '"]');
  return bar
    ? Array.prototype.slice.call(bar.querySelectorAll("input[data-label-value]"))
    : [];
}

function _transectTagSelects(containerId) {
  var bar = document.querySelector('.filter-bar[data-scope="' + containerId + '"]');
  return bar
    ? Array.prototype.slice.call(bar.querySelectorAll("select[data-tag-family]"))
    : [];
}

function _transectCardFilter(containerId) {
  var c = document.getElementById(containerId);
  if (!c) return;
  var checks = _transectLabelChecks(containerId);
  var tagSelects = _transectTagSelects(containerId);
  var allowed = {};
  checks.forEach(function(el) {
    if (el.checked) allowed[el.getAttribute("data-label-value")] = true;
  });
  var flushEl = document.getElementById(containerId + "-flush");
  var intvEl = document.getElementById(containerId + "-intv");
  var subagEl = document.getElementById(containerId + "-subag");
  var confEl = document.getElementById(containerId + "-conf");
  var wantFlush = !!(flushEl && flushEl.checked);
  var wantIntv = !!(intvEl && intvEl.checked);
  var wantSubag = !!(subagEl && subagEl.checked);
  var confBand = confEl ? confEl.value : "";
  var cards = c.querySelectorAll(".event");
  var shown = 0;
  cards.forEach(function(card) {
    var okLabel = checks.length === 0 || !!allowed[card.getAttribute("data-label")];
    var okFlush = !wantFlush || card.getAttribute("data-after-flush") === "1";
    var okIntv = !wantIntv || card.getAttribute("data-after-intervention") === "1";
    var okSubag = !wantSubag
      || (parseFloat(card.getAttribute("data-subagents")) || 0) > 0;
    var okConf = true;
    if (confBand) {
      var conf = parseFloat(card.getAttribute("data-confidence"));
      okConf = confBand === "high" ? conf >= 0.8 : conf < 0.6;
      if (isNaN(conf)) okConf = false;
    }
    // every active tag selector must match one of the card's own
    // "|family=value|" keys (data-tags, fenced against prefix collisions)
    var okTags = tagSelects.every(function(sel) {
      if (!sel.value) return true;
      var key = "|" + sel.getAttribute("data-tag-family") + "=" + sel.value + "|";
      return (card.getAttribute("data-tags") || "").indexOf(key) >= 0;
    });
    var visible = okLabel && okFlush && okIntv && okSubag && okConf && okTags;
    card.style.display = visible ? "" : "none";
    if (visible) shown++;
  });
  var count = document.getElementById(containerId + "-count");
  if (count) count.textContent = "showing " + shown + " of " + cards.length + " phases";
  var empty = document.getElementById(containerId + "-empty");
  if (empty) empty.hidden = shown > 0;
}

function _transectClearCardFilters(containerId) {
  _transectLabelChecks(containerId).forEach(function(el) { el.checked = true; });
  var flushEl = document.getElementById(containerId + "-flush");
  var intvEl = document.getElementById(containerId + "-intv");
  var subagEl = document.getElementById(containerId + "-subag");
  var confEl = document.getElementById(containerId + "-conf");
  if (flushEl) flushEl.checked = false;
  if (intvEl) intvEl.checked = false;
  if (subagEl) subagEl.checked = false;
  if (confEl) confEl.value = "";
  _transectTagSelects(containerId).forEach(function(sel) { sel.value = ""; });
  _transectCardFilter(containerId);
}

// Token spend: the custom-grouping selector shows one tag family's
// chart at a time (each family's chart is its own hidden-able div).
function _transectSpendFamily(scope, family) {
  document.querySelectorAll('[data-spend-scope="' + scope + '"]').forEach(function(el) {
    el.hidden = el.getAttribute("data-spend-family") !== family;
  });
}

// initial "showing N of M phases" line for every transcript's bar (also
// covers the no-JS-yet-run window right after load, before any control
// is touched).
function _transectInitCardFilters() {
  document.querySelectorAll(".filter-bar[data-scope]").forEach(function(bar) {
    _transectCardFilter(bar.getAttribute("data-scope"));
  });
}
document.addEventListener("DOMContentLoaded", _transectInitCardFilters);

// "Back to top" visibility: appears once the reader is a screen down
// (covers both plain scrolling and a band click-to-card jump).
function _transectBackTopVisibility() {
  var el = document.getElementById("transect-back-top");
  if (el) el.style.display = window.scrollY > window.innerHeight ? "block" : "none";
}
window.addEventListener("scroll", _transectBackTopVisibility);
document.addEventListener("DOMContentLoaded", _transectBackTopVisibility);
</script>
</body></html>
