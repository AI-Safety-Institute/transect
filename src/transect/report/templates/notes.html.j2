{#- Small standalone note/legend fragments shared across a transcript's
    sections. Each macro takes already-computed plain values (numbers,
    strings, small dicts/lists) - no pandas objects - and produces one
    self-contained HTML fragment; autoescape handles every interpolation,
    so callers pass raw (unescaped) text. -#}

{% macro section(title, blocks, anchor=None) -%}
<div{% if anchor %} id="{{ anchor }}"{% endif %} class="section">{% if title %}<h3>{{ title }}</h3>{% endif %}{% for block in blocks %}{{ block }}{% endfor %}</div>
{%- endmacro %}

{% macro chip(swatch_style, text) -%}
<span class="chip"><span class="swatch" style="{{ swatch_style }}"></span>{{ text }}</span>
{%- endmacro %}

{#- A small horizontal-rule swatch for a legend naming a *line* mark on
    a chart (context-flush / human-intervention rules); `.swatch` above
    suits a fill, not a line. ``style`` is "solid" or "dashed", the two
    chart line styles this report draws. -#}
{% macro line_swatch(color, style="solid") -%}
<span class="swatch-line" style="border-top-color:{{ color }}; border-top-style:{{ style }};"></span>
{%- endmacro %}

{#- The report's very-top intro: one deterministic sentence composed
    from recorded facts (sections.run_intro_line), directly under the
    transcript heading. -#}
{% macro intro_line(text) -%}
<p class="meta">{{ text }}</p>
{%- endmacro %}

{#- The intro's three default-collapsed expandables (Core setup /
    Additional config details / Run summary - the eval-setup surface).
    Rows are (label, value) pairs, every value pre-worded by
    sections.eval_setup_blocks ("not recorded by source" / "not set" included);
    prompts are (label, verbatim text) sub-expandables - untrusted
    agent-facing content, interpolated raw into autoescape. -#}
{% macro setup_blocks(blocks) -%}
{% for b in blocks %}<details class="event"><summary>{{ b.title }}</summary>{% for label, value, definition in b.rows %}<p class="meta">{% if definition %}<strong><span title="{{ definition }}">{{ label }}</span></strong>{% else %}<strong>{{ label }}</strong>{% endif %}: {{ value }}</p>{% endfor %}{% for label, text in b.prompts %}<details class="event definitions"><summary>{{ label }}</summary><p class="prompt-verbatim">{{ text }}</p></details>{% endfor %}</details>{% endfor %}
{%- endmacro %}


{#- ``threshold``: the drawn compaction threshold in tokens, or none when
    the context chart carries no threshold rule. -#}
{% macro event_legend(has_context_chart, flushes=True, threshold=None) -%}
{% if flushes and has_context_chart -%}
<p class="meta">{{ line_swatch('#c44e52', 'dashed') }}dashed red = context flush event, marked on both the bars and context-window charts above; hover a bar for the flush detail.</p>
{%- elif flushes -%}
<p class="meta">{{ line_swatch('#c44e52', 'dashed') }}context flush: appears on the token telemetry chart; hover that turn for the flush detail.</p>
{%- endif %}
{% if threshold is not none -%}
<p class="meta">{{ line_swatch('#9467bd', 'dotted') }}dotted purple = configured compaction threshold ({{ '{:,}'.format(threshold) }} tokens) on the context-window chart; the checkbox above it hides the line.</p>
{%- endif %}
{%- endmacro %}

{#- No bold "Token telemetry" lead-in: the section's own header names
    it, and repeating it two lines apart reads as a duplicate. -#}
{#- ``coincide``: the two per-turn measures are equal on every turn
    (no cache usage recorded), so the selector visibly changes nothing. -#}
{% macro token_intro_derived(coincide=False) -%}
<p class="meta explainer">Three measures of the orchestrator's per-turn token stream, selectable below (sub-agent lanes are off this axis; their spend is under Token spend, by sub-agent label; Inspect input_tokens excludes cache reads and writes; output includes reasoning; missing optional breakdowns count as zero in derived views):</p>
<ul class="meta explainer"><li><strong>per-turn total</strong>: everything this turn's API call processed (re-read context plus new output); drops after a context flush</li><li><strong>per-turn new work</strong>: an estimate of new content from uncached input, output and context growth; not a measure of effort</li><li><strong>cumulative (excluding cache reads)</strong>: uncached input, output and cache-write tokens summed over orchestrator turns; excludes cache reads and is not monetary cost</li></ul>
{% if coincide %}<p class="meta">This transcript recorded no cache reads or writes, so per-turn total and per-turn new work are equal on every turn: switching between them changes nothing here.</p>{% endif %}
{%- endmacro %}

{% macro token_intro_raw() -%}
<p class="meta explainer">The orchestrator's per-call output tokens (pre-derivation fallback: this transcript's usage events don't carry the cache/context breakdown the three-measure view needs).</p>
<p class="meta explainer">Scale: <em>linear</em> or <em>log</em> (log hides turns with a zero or negative token count, since a token count of zero has no logarithm; a turn with no reading at all is hidden under either scale).</p>
{%- endmacro %}

{#- This fact belongs with the chart whose measures it explains, not on
    a judge-reliability surface. -#}
{#- Both event lists below are a <details class="event event-list">
    whose <summary> is just the count and whose body is one <li> per
    event, turn-ordered (the builders in sections.py sort explicitly, so
    this template does not have to trust its caller). Same card
    border/radius and summary hover as `.event`, but a muted rather than
    semibold summary - these are meta-level detail, not primary
    content. -#}
{#- The before/after counts are the recorded compaction event's own
    figures, not chart readings: the two measures differ by construction
    (the chart is per-call reported input; Inspect's before is its estimate
    of the conversation it was about to send, its after counts only the
    kept messages), so the list says so rather than leaving the reader to
    reconcile them. -#}
{% macro flush_line(flushes, n_off_axis=0) -%}
<details class="event event-list"><summary>{{ flushes|length }} context flush(es) &middot; dashed lines on the charts above{% if n_off_axis %} &middot; {{ n_off_axis }} more in sub-agent lanes (off the turn axis: in the flushes frame, not charted){% endif %}</summary><ol>{% for f in flushes %}<li>before turn {{ f.turn }} &middot; {{ f.type }}/{{ f.source }}{% if f.amount %} &middot; {{ f.amount }}{% endif %}</li>{% endfor %}</ol><p class="meta explainer">Token counts are the recorded compaction event's own (tokens before &rarr; after), not readings off the chart. The chart's context is what each API call reported: at a summary flush the turn before the flush turn is the summarization call itself, whose input is the whole conversation plus the summary prompt, and the flush turn (the first call after it) adds the tool definitions back on top of the kept messages.</p></details>
{%- endmacro %}

{#- Full text, never cut: the list exists to be read, and a message
    can run to many lines (`.intervention-text` scrolls past a cap).
    An agent-initiated exchange shows the question (when the source
    recorded one) and the answer; an empty answer says so. -#}
{% macro intervention_line(interventions) -%}
<details class="event event-list"><summary>{{ interventions|length }} human intervention(s) &middot; solid navy lines on the chart above</summary><ol>{% for i in interventions %}<li>before turn {{ i.turn }} &middot; {{ i.channel }}{% if i.outcome %} &middot; {{ i.outcome }}{% endif %}{% if i.agent %}{% if i.prompt %}<div class="intervention-text"><span class="meta">asked (agent):</span> {{ i.prompt }}</div>{% endif %}<div class="intervention-text"><span class="meta">{{ "answered" if i.prompt else "recorded" }} (human):</span> {% if i.content %}{{ i.content }}{% else %}<span class="meta">no answer recorded</span>{% endif %}</div>{% else %}<div class="intervention-text"><span class="meta">message (human):</span> {% if i.content %}{{ i.content }}{% else %}<span class="meta">empty message</span>{% endif %}</div>{% endif %}</li>{% endfor %}</ol></details>
{%- endmacro %}

{% macro intervention_legend() -%}
<p class="meta explainer">{{ line_swatch('#0E2841') }}solid navy = human intervention &middot; hover for source + message</p>
{%- endmacro %}

{#- No heading of its own: the Phase timeline section's Jinja header
    (notes.section) names it, and one header per section is the rule. -#}
{% macro phase_chips(reuse_note, chips) -%}
{% if reuse_note %}<p class="meta">{{ reuse_note }}</p>{% endif %}<p class="chips">{% for c in chips %}{{ chip(c.swatch_style, c.text) }}{% endfor %}</p>
{%- endmacro %}

{#- The agreement strip's caption, directly under the chart it
    explains: an unexplained, unlabeled strip under the band reads as a
    rendering defect rather than a feature. Rendered only when the strip
    itself has data (`charts.has_judge_agreement`) - never a caption for
    a chart element that isn't there. -#}
{% macro agreement_strip_caption() -%}
<p class="meta"><strong>Strip under the band = per-turn judge agreement</strong> (not confidence): the share of judges whose vote matched the turn's label, darker teal = more agreed; grey = no vote agreement to show (turn not judged, judged by a single voter, or verifier re-label). Hover a cell for the members' own votes.</p>
{%- endmacro %}

{#- Why there is no strip, in its place. ``solo`` = single judge; else a
    voting regime on which no turn ended with a vote. -#}
{% macro agreement_strip_absent(solo) -%}
{% if solo -%}
<p class="meta">No per-turn agreement strip on this run: a single judge (no k_rolls, no cohort) has no one to agree with, so the reliability reading here is the judge's stated confidence plus any verifier review.</p>
{%- else -%}
<p class="meta">No per-turn agreement strip on this run: no turn ended with a vote to measure agreement on (see the member coverage in the reliability audit).</p>
{%- endif %}
{%- endmacro %}

{#- The Phase timeline section's body when the run has no phases;
    ``requested`` = the phase judge ran and produced none. -#}
{% macro no_phases_note(requested) -%}
{% if requested -%}
<p class="meta">The phase judge ran but produced no phases for this transcript, so there is no phase timeline, no phase cards and no token spend by phase. See the Scan execution &amp; coverage block at the end of the report for the recorded errors.</p>
{%- else -%}
<p class="meta">No judge was configured for this scan (<code>judge_models=None</code>), so there is no phase segmentation: the phase timeline, the phase cards and token spend by phase are absent. Pass <code>judge_models</code> with a spec that declares <code>phases</code> to add them.</p>
{%- endif %}
{%- endmacro %}

{% macro group_heading(text) -%}
<h4>{{ text }}</h4>
{%- endmacro %}

{#- The Token spend section's custom grouping: heading + one selector
    over the user layers' tag families; `_transectSpendFamily` (report.html.j2)
    swaps which family's spend_family_group div is visible. -#}
{#- No data-scope on the bar: that attribute would enrol it in the
    phase-card filter init (`.filter-bar[data-scope]`); the charts'
    own divs carry data-spend-scope instead. -#}
{% macro spend_family_control(scope, options) -%}
<h4>By custom tag family <span class="custom-layer-badge">custom</span></h4>
<div class="filter-bar"><label>Group by: <select onchange="_transectSpendFamily('{{ scope }}', this.value)">{% for o in options %}<option value="{{ o.family }}" title="user tag family from layer '{{ o.layer }}'">{{ o.family }} ({{ o.layer }})</option>{% endfor %}</select></label></div>
{%- endmacro %}

{% macro spend_family_group(scope, family, chart, hidden) -%}
<div data-spend-scope="{{ scope }}" data-spend-family="{{ family }}"{% if hidden %} hidden{% endif %}>{{ chart }}</div>
{%- endmacro %}

{% macro spend_subagent_unavailable() -%}
<p class="meta explainer">Delegated token spend is unavailable in this export (sub-agent lanes are tool-events-only).</p>
{%- endmacro %}

{% macro narrator_line(model) -%}
<p class="meta explainer">Card headlines and summaries are LLM-generated narration by {{ model }}; descriptive, not a validated account.</p>
{%- endmacro %}

{% macro phase_cards_explanation() -%}
<p class="meta explainer">One expandable card per phase, chronological - the drill-down for the Phase timeline (clicking a phase chunk there jumps to its card here).</p>
{%- endmacro %}

{% macro phase_explanation() -%}
<p class="meta explainer">An LLM judge segments this run into labelled phases, matched against the spec's phase vocabulary; the labels and boundaries are the judge's output.</p>
{%- endmacro %}

{#- The Sub-agent activity section's analogue of `phase_explanation`
    above, same shape. Worded to name only the classifier's output
    vocabulary, never its inputs: the scanner's own prompt basis
    (`transect/scanners/subagents.py`) can change independently of this
    report, and this sentence must stay true either way. -#}
{% macro subagent_explanation() -%}
<p class="meta explainer">An LLM judge classifies each spawned sub-agent against the spec's sub-agent label vocabulary; the labels are the judge's output.</p>
{%- endmacro %}

{% macro phase_summary_line(n_phases, judge_label, judge, cohort, verifier=None) -%}
<p class="meta">{{ n_phases }} phases · {{ judge_label }}: {{ judge }}{% if cohort %} · cohort: {{ cohort.detail }} · mean per-turn agreement: {{ cohort.mean }} over {{ cohort.n_turns }} turn(s) with ≥ 2 voters{% endif %}{% if verifier %} · verifier: {{ verifier }}{% endif %}</p>
{%- endmacro %}

{% macro phase_meta_line(n_phases, judge_label, judge, cohort, verifier_note, unjudged_count) -%}
<p class="meta">{{ n_phases }} phases · {{ judge_label }}: {{ judge }}{% if cohort %} · cohort: {{ cohort.detail }} · mean per-turn agreement: {{ cohort.mean }} over {{ cohort.n_turns }} turn(s) with ≥ 2 voters{% endif %}{% if verifier_note %} · verifier: {{ verifier_note.overturned }} of {{ verifier_note.verified }} completed original phase reviews relabelled ({{ verifier_note.selected }} selected){% if verifier_note.same_model %} <span class="meta">(verifier = the same model; self-revision under a different prompt)</span>{% endif %}{% endif %}{% if unjudged_count %} · <span class="meta">{{ unjudged_count }} unjudged turn(s) greyed</span>{% endif %} · turn indices are 0-based (the Scout viewer numbers every lane's model calls from 1, so its turn chip differs on runs with sub-agents; deep links land on the event itself)</p>
{%- endmacro %}

{% macro label_definitions(title, entries) -%}
<details class="event definitions"><summary>{{ title }}</summary><ul>{% for e in entries %}<li><strong>{{ e.label }}</strong>{% if e.description %}: {{ e.description }}{% endif %}</li>{% endfor %}</ul></details>
{%- endmacro %}

{% macro definitions_unavailable(title) -%}
<details class="event definitions"><summary>{{ title }}</summary><p class="meta">Label definitions are not recorded for this surface. Judging may have been disabled, or this may be an older store. If judged labels are needed, configure the intended vocabulary before a new judged run.</p></details>
{%- endmacro %}
